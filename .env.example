# APP_URL: Public URL where the 2Frères Phone platform is hosted
APP_URL="https://2freresphone.vercel.app"

# INITIAL_ADMIN_EMAIL: Primary administrator email granted access to /admin
INITIAL_ADMIN_EMAIL="badroumc@gmail.com"

# Optional SMTP configuration for automatic low-stock alert emails to administrator
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="2Freres Phone <no-reply@2freresphone.dz>"

# Optional Resend API key (alternative to SMTP for low-stock alert emails)
RESEND_API_KEY=""
